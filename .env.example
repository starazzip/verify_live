# verify_live API / Web 共同環境變數

# 預設會先抓 verify_live 上層目錄（若有 user_data）；若仍需指定，填這個路徑
# VERIFY_LIVE_WORKSPACE_ROOT=C:/Azzip/Projects/freq_live

# 啟動埠
VERIFY_LIVE_API_HOST=127.0.0.1
VERIFY_LIVE_API_PORT=8011
VERIFY_LIVE_WEB_PORT=5179

# Freqtrade CLI（留空會自動嘗試使用 repo/.venv/Scripts/freqtrade.exe）
# VERIFY_LIVE_FREQTRADE_BIN=freqtrade

# Config 掃描根目錄（可多個，以 ; 或 , 分隔）
VERIFY_LIVE_CONFIG_ROOTS=user_data/configs;user_data/bot_spot_zz_hkrsif_freq/configs

# 預設容忍度
VERIFY_LIVE_DEFAULT_PRICE_TOL_BPS=10
VERIFY_LIVE_DEFAULT_QTY_TOL_RATIO=0.005

# Live Freqtrade API（建議由 profile 帶入 base_url/username，密碼只走 env）
VERIFY_LIVE_API_BASE_URL=
VERIFY_LIVE_API_USER=
VERIFY_LIVE_API_PASSWORD=
